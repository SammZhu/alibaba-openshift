#jinja2: trim_blocks: True, lstrip_blocks: True
# agent-config.yaml for the Agent-based Installer (installation_method=Agent-based).
# Rendered by ansible/tasks/iso_agent.yml.
#
# Network model (ENI-first, 2026-06-16): hosts[] binds each master's pre-created
# ENI MAC -> hostname.  This is the ONLY way the rendezvous/node-zero gets a
# deterministic name: the assisted agent reads the hostname from config at
# registration, so it no longer matters whether the OS hostname has settled from
# DHCP/PTR yet (an earlier DHCP-only + empty-hosts[] attempt left node-zero named
# after its MAC, because it gathered inventory while its hostname was still
# localhost).  The MACs are known before the ISO is built because 06 phase-1
# boots the masters from a placeholder image (fixed IPs, auto primary ENIs) and
# harvests those ENIs' MACs; 06b phase-2 reimages the masters to the agent image
# in place (ReplaceSystemDisk keeps the ENI/MAC/IP).  We still rely on DHCP to
# hand each ENI its fixed IP (no static NMState / networkConfig), so a host entry
# is just {hostname, role, MAC matcher, rootDeviceHints=/dev/vda}.  rendezvousIP
# must equal master-1's fixed IP (ROS RendezvousIp / ansible rendezvous_ip, in
# the masters' subnet, e.g. 10.0.32.0/20).
# bootArtifactsBaseURL — air-gap: the External-platform agent ISO is always a
# MINIMAL ISO that fetches its ~1 GB rootfs over HTTP at boot. Without this it
# points at the public rhcos.mirror.openshift.com (breaks air-gap, slow/blocked
# in China). Point it at an in-VPC HTTP server on the mirror ECS (tasks/
# iso_agent.yml serves boot-artifacts/agent.x86_64-rootfs.img there via a
# systemd python http.server on :8080; the mirror SG opens 8080 to the VPC).
# Nodes then pull the rootfs from the mirror ECS in-VPC, no public internet.
apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ cluster_name }}
rendezvousIP: {{ rendezvous_ip }}
bootArtifactsBaseURL: http://{{ mirror_private_ip }}:8080
# Bootstrap/discovery-phase NTP — Alibaba Cloud INTERNAL NTP, reachable inside
# the VPC WITHOUT egress (like IMDS 100.100.100.200).  The chrony MachineConfig
# (50-chrony-aliyun-internal-*) only applies AFTER the cluster is up (MCO); this
# covers the discovery+bootstrap window so a node never drifts (+8h CST) and
# fails the "Host clock is not synchronized" validation, regardless of NAT.
# This is an agent-config field (NOT install-config — that one panics wait-for).
# On Apsara these are auto-discovered from the mirror ECS (apsara_node_ntp): the
# public-cloud NTP names below are NOT resolvable there, chrony never syncs, and
# the node's clock ends up +8h (CST read as UTC).  Every certificate it then
# issues has a NotBefore 8 hours in the future and the cluster fails TLS against
# itself — install dies at ~50% with "certificate is not yet valid".
additionalNTPSources:
{% if (apsara_node_ntp | default([])) | length > 0 %}
{% for s in apsara_node_ntp %}
  - {{ s }}
{% endfor %}
{% else %}
  - ntp.cloud.aliyuncs.com
  - ntp1.cloud.aliyuncs.com
  - 100.100.5.1
{% endif %}
{#- One entry per node.  Masters and split ingress workers differ only in role,
    hostname and which net list they index — the nmstate block is identical, and
    it encodes a rule that cost a failed HA attempt to learn (each node needs
    ITS OWN gateway and prefix, not one shared pair).  Two copies of that means
    the next fix lands in only one of them, so they share this macro. -#}
{% macro host_entry(mac, role, index, net) %}  - hostname: {{ cluster_name }}-{{ role }}-{{ index }}
    role: {{ role }}
    rootDeviceHints:
      deviceName: /dev/vda
    interfaces:
      - name: {{ apsara_node_nic | default('eth0') }}
        macAddress: "{{ mac | lower }}"
{% if (cloud_platform | default('public')) == 'apsara' %}
    # Apsara: RHCOS's DHCP client does not get a lease on this VPC, so pin a
    # STATIC address/gateway/DNS via nmstate (Alibaba Cloud Linux works via DHCP,
    # RHCOS does not).  IP is the ENI's fixed address; NIC name is ens3 on Apsara.
    #
    # Address, prefix and gateway all come from this node's own net entry,
    # because each node lives in its own vSwitch.  They used to be one address
    # from the list plus private_subnet_cidr's prefix plus the single
    # apsara_node_gateway — fine for SNO, and the reason masters 2 and 3 came up
    # with an unusable next-hop the first time HA was attempted.
    networkConfig:
      interfaces:
        - name: {{ apsara_node_nic | default('eth0') }}
          type: ethernet
          state: up
          mac-address: "{{ mac | lower }}"
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ net.ip }}
                prefix-length: {{ net.prefix }}
      dns-resolver:
        config:
          server:
{% for ns in (apsara_node_dns | default([])) %}
            - {{ ns }}
{% endfor %}
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: {{ net.gw }}
            next-hop-interface: {{ apsara_node_nic | default('eth0') }}
            table-id: 254
{% endif %}
{%- endmacro %}
# One host entry per master (abi_master_macs: SNO=1, HA=3), then one per split
# ingress worker (abi_worker_macs: empty unless EnableSplitWorkers built them).
# Both lists are bound POSITIONALLY to their net lists, which iso_agent.yml
# asserts are the same length.
{% if (abi_master_macs | default([])) | length > 0 %}
hosts:
{% for mac in abi_master_macs %}
{{ host_entry(mac, 'master', loop.index,
              (abi_master_net | default([]))[loop.index0]
              if (cloud_platform | default('public')) == 'apsara' else {}) }}
{% endfor %}
{% for mac in (abi_worker_macs | default([])) %}
{{ host_entry(mac, 'worker', loop.index,
              (abi_worker_net | default([]))[loop.index0]
              if (cloud_platform | default('public')) == 'apsara' else {}) }}
{% endfor %}
{% else %}
# Fallback (no MACs harvested — e.g. ENI-first phase-1 not run): empty hosts[],
# nodes get DHCP-pinned IPs but the rendezvous may fall back to a MAC hostname.
hosts: []
{% endif %}
