#jinja2: trim_blocks: True, lstrip_blocks: True
# install-config.yaml for the Agent-based Installer (installation_method=agent).
# Rendered by ansible/tasks/iso_agent.yml on the operator host, then consumed by
# `openshift-install agent create image`.  Field-for-field equivalent to the
# Assisted-Installer path: the cluster-object payload in 01-prepare-iso.yml
# (platform.external / topology / pullSecret / sshKey) PLUS the install-config
# overrides that the AI path applies via PATCH in 04-prepare-mirror.yml
# (imageDigestSources + additionalTrustBundle).  Keep the two in sync.
apiVersion: v1
metadata:
  name: {{ cluster_name }}
baseDomain: {{ base_domain }}
# NOTE: bootstrap/discovery-phase NTP (Alibaba internal NTP) lives in
# agent-config.yaml as additionalNTPSources — it is NOT a valid install-config
# field (openshift-install rejects "unknown field additionalNTPSources" and the
# agent asset store then panics in wait-for).
networking:
  clusterNetwork:
    - cidr: 10.128.0.0/14
      hostPrefix: 23
  networkType: OVNKubernetes
  machineNetwork:
    - cidr: {{ vpc_cidr }}
  serviceNetwork:
    - 172.30.0.0/16
compute:
  - architecture: amd64
    hyperthreading: Enabled
    name: worker
    replicas: {{ _eff_compute_count | int }}
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: {{ _eff_control_plane_count | int }}
platform:
  external:
    platformName: AlibabaCloud
{% if ccm_enabled | default(true) %}
    # Declaring External makes kubelet run with --cloud-provider=external and
    # taint every node node.cloudprovider.kubernetes.io/uninitialized until a
    # CCM clears it.  That is a hard dependency: a CCM that cannot reach its
    # cloud deadlocks the install outright — nothing schedules, OVN never
    # starts, nodes stay NotReady.  On Apsara this was false for a long time
    # (the CCM resolved ecs-vpc.<region>.aliyuncs.com, which does not exist
    # there), which is why this used to default off.
    #
    # It now defaults on, because the pieces exist: 08d builds an image whose
    # SDK can decode this gateway's responses, and the manifest passes the
    # private-cloud endpoints and HTTP scheme through.  Both are required —
    # an install with ccm_enabled and a stock image will deadlock.
    #
    # Escape hatch, if an install hangs with nodes NotReady and tainted
    # uninitialized: -e ccm_enabled=false, which omits this line, drops the
    # taint, and costs only ProviderID and LoadBalancer Services.
    cloudControllerManager: External
{% endif %}
{% if mirror_enabled | default(false) | bool %}
# Mirror redirect — identical source->mirror mapping as the AI install-config
# PATCH (04-prepare-mirror.yml: oc-mirror v2 publishes exactly these two repos).
imageDigestSources:
  - source: quay.io/openshift-release-dev/ocp-release
    mirrors:
      - {{ mirror_private_ip }}:8443/openshift/release-images
  - source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
    mirrors:
      - {{ mirror_private_ip }}:8443/openshift/release
{% if ccm_enabled | default(true) %}
  # The CCM has to be pullable before the cluster exists: kubelet taints every
  # node uninitialized until it runs, so nothing schedules until it does — an
  # ImageDigestMirrorSet applied afterwards is far too late.  Only this file is
  # in force during bootstrap.
  #
  # 04 carries the same mapping for the Assisted-Installer path, which is a
  # different file; the two lists have to be kept in step by hand, and were not.
  - source: registry-cn-hangzhou.ack.aliyuncs.com/acs/cloud-controller-manager
    mirrors:
      - {{ mirror_private_ip }}:8443/acs/cloud-controller-manager
{% endif %}
additionalTrustBundlePolicy: Always
additionalTrustBundle: |
{{ _mirror_ca_cert | indent(2, true) }}
{% endif %}
pullSecret: '{{ _pull_secret_effective }}'
sshKey: '{{ _ssh_pub_key }}'
